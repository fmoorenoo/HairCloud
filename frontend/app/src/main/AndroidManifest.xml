<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        Seguridad:
        - Sin usesCleartextTraffic: el tráfico HTTP en claro queda prohibido salvo
          los hosts de desarrollo declarados en el network_security_config de debug.
        - allowBackup=false y reglas de extracción vacías: los tokens de sesión no
          se copian a copias de seguridad ni se transfieren a otro dispositivo.
    -->
    <application
        android:name=".HairCloudApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/app_icon"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HairCloud"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HairCloud">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
