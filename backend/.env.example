# Copia este fichero a .env y rellena los valores. .env nunca se sube a git.

# development | production | testing  (por defecto: production)
APP_ENV=development

# Secretos: genera valores largos y aleatorios, por ejemplo con
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=

# Base de datos (o bien DATABASE_URL=postgresql://usuario:clave@host:5432/HairCloud)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=HairCloud
DB_USER=haircloud_app
DB_PASSWORD=

# Base de datos para los tests (se vacía en cada ejecución: no uses la real)
TEST_DATABASE_URL=postgresql://haircloud_app:CLAVE@localhost:5432/haircloud_test

APP_TIMEZONE=Europe/Madrid

# Correo: smtp | console (muestra los correos en el log) | memory
MAIL_BACKEND=console
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
# Para Gmail usa una "contraseña de aplicación", no la contraseña de la cuenta.
MAIL_PASSWORD=
MAIL_SENDER_NAME=Soporte de HairCloud

# Sesiones
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Rate limiting (con varios procesos usa redis://localhost:6379)
RATELIMIT_STORAGE_URI=memory://
# Número de proxies inversos de confianza delante de la API (0 = ninguno)
TRUSTED_PROXIES=0
